# Qdrant — wybierz jedną opcję / choose one option:

# Opcja A: Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_KEY=your_qdrant_api_key_here

# Opcja B: Qdrant lokalny (dev) — QDRANT_KEY jest wymagany (dowolny string, np. dev-local-key)
# ./scripts/setup-local-dev.sh
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_KEY=dev-local-key

ACTIVE_COLLECTION=dokumenty

# Ollama (embeddingi ZAWSZE przez Ollama, także gdy chat = OpenRouter)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3:latest
EMBED_MODEL=nomic-embed-text

# OpenRouter (przełącznik w UI) — chat; embedding nadal Ollama
# LLM_PROVIDER=ollama          # ollama | openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_VERIFY=google/gemini-2.0-flash-exp:free
# OPENROUTER_FALLBACK_TO_OLLAMA=true
# OPENROUTER_MAX_RETRIES=3

# OCR (opcjonalnie)
# OCR_LANG=pol+eng

# SQL Server (opcjonalnie — text-to-SQL / hybryda)
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=sa
SQL_PASSWORD=YourPassword

# Import / przeglądarka plików (dwukropki = wiele ścieżek; WSL: /mnt/c = dysk C:, /mnt/g = Google Drive)
SEARCH_ROOTS=/mnt/g:/mnt/c:/home/marcin/Documents

# Bezpieczeństwo
# APP_HOST=127.0.0.1
# APP_PORT=5000
# APP_API_KEY=
