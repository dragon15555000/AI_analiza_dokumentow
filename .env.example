# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_KEY=your_qdrant_api_key_here
ACTIVE_COLLECTION=dokumenty

# Ollama Local
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3:latest

# SQL Server (opcjonalnie — dla text-to-SQL)
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=sa
SQL_PASSWORD=YourPassword

# File search paths (colon-separated, leave empty to disable)
SEARCH_ROOTS=/mnt/g:/home/marcin/Documents:/home/marcin/Desktop
