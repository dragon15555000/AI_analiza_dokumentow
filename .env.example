# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_KEY=your_qdrant_api_key_here
ACTIVE_COLLECTION=dokumenty

# Ollama Local
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3:latest

# OpenRouter (przełącznik w UI)
# LLM_PROVIDER=ollama          # ollama | openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free   # tani lub darmowy model
OPENROUTER_MODEL_VERIFY=meta-llama/llama-3.1-8b-instruct:free   # opcjonalnie inny model do weryfikacji (Krytyk)
# OPENROUTER_FALLBACK_TO_OLLAMA=true   # domyślnie włączone — przełącz na Ollama przy limicie OpenRouter
# OPENROUTER_FALLBACK_TO_OLLAMA=false  # ustaw aby wyłączyć automatyczny fallback
# OPENROUTER_MAX_RETRIES=3

# Przykłady tanich/darmowych modeli:
# meta-llama/llama-3.1-8b-instruct:free
# google/gemini-flash-1.5
# mistralai/mistral-7b-instruct
# qwen/qwen-2.5-7b-instruct

# SQL Server (opcjonalnie — dla text-to-SQL)
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=sa
SQL_PASSWORD=YourPassword

# File search paths (colon-separated, leave empty to disable)
SEARCH_ROOTS=/mnt/g:/home/marcin/Documents:/home/marcin/Desktop
