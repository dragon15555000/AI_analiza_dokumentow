# Qdrant — wybierz jedną opcję / choose one option:

# Opcja A: Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_KEY=your_qdrant_api_key_here

# Opcja B: Qdrant lokalny (dev) — QDRANT_KEY jest wymagany (dowolny string, np. dev-local-key)
# ./scripts/setup-local-dev.sh
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_KEY=dev-local-key

ACTIVE_COLLECTION=dokumenty

# Ollama (embeddingi ZAWSZE przez Ollama, także gdy chat = OpenRouter)
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_URLS=http://127.0.0.1:11434,http://192.168.1.10:11434   # pool serwerów (rotacja round-robin)
LLM_MODEL=llama3:latest
EMBED_MODEL=nomic-embed-text

# OpenRouter (przełącznik w UI) — chat; embedding nadal Ollama
# LLM_PROVIDER=ollama          # ollama | openrouter | groq
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb   # pool kluczy (rotacja przy 429/auth)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_VERIFY=google/gemini-2.0-flash-exp:free

# Google Gemini — audyt dużych plików / logów (bezpośrednie API, okno ~1M tokenów)
# Klucz: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_AUDIT_MAX_BYTES=12582912

# Groq (szybkie testy — OpenAI-compatible API)
# GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=gsk_aaa,gsk_bbb   # pool kluczy (rotacja przy 429/auth)
# GROQ_MODEL=groq/compound
# (dozwolone w org: compound, compound-mini, llama-3.3-70b-versatile, llama-4-scout, qwen3-32b, gpt-oss-*)
# GROQ_MODEL_VERIFY=llama-3.1-8b-instant
# LLM_PROVIDER=groq
# OPENROUTER_FALLBACK_TO_OLLAMA=true
# OPENROUTER_MAX_RETRIES=3

# OCR (opcjonalnie)
# OCR_LANG=pol+eng

# SQL Server (opcjonalnie — text-to-SQL / hybryda)
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=YourDatabase
SQL_USER=sa
SQL_PASSWORD=YourPassword

# Import / przeglądarka plików (dwukropki = wiele ścieżek; WSL: /mnt/c = dysk C:, /mnt/g = Google Drive)
SEARCH_ROOTS=/mnt/g:/mnt/c:/home/marcin/Documents

# Bezpieczeństwo
# APP_HOST=127.0.0.1
# APP_PORT=5000
# APP_API_KEY=
# TRUST_PROXY=false   # ustaw true tylko za zaufanym reverse proxy, które czyści X-Forwarded-For
