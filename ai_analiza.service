[Unit]
Description=AI Analiza Dokumentów (Waitress)
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{WORKDIR}}

# Ścieżka do venv
Environment="PATH={{WORKDIR}}/venv/bin"
EnvironmentFile={{WORKDIR}}/.env

# Produkcyjny start przez waitress
ExecStart={{WORKDIR}}/venv/bin/python -m waitress \
    --listen=0.0.0.0:5000 \
    --threads=8 \
    --url-scheme=http \
    --ident="ai-analiza" \
    wsgi:app

Restart=always
RestartSec=5

# Ograniczenia (dostosuj pod serwer)
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
