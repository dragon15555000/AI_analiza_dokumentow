      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Call Swarm Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Endpoint /agents/swarm/stream zwraca SSE (text/event-stream).\n// n8n odbiera surowy tekst — parsujemy linie zaczynające się od 'data:'.\nconst raw = $input.first().json.data || $input.first().json.body || '';\nconst lines = String(raw).split('\\n');\nconst events = [];\nfor (const line of lines) {\n  if (line.startsWith('data:')) {\n    const payload = line.slice(5).trim();\n    if (payload === '[DONE]') continue;\n    try {\n      events.push(JSON.parse(payload));\n    } catch (_) {\n      events.push({ raw: payload });\n    }\n  }\n}\nreturn [{ json: { events, count: events.length } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Parse SSE Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
