{
  "name": "03 Scheduled Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5000/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "PLACEHOLDER_APP_API_KEY"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Check App Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3000/v1/models",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer PLACEHOLDER_NEW_API_KEY"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "allowUnauthorizedCerts": false
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Check new-api :3000",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:6333/healthz",
        "options": {
          "timeout": 5000
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Check Qdrant :6333",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 540]
    },
    {
      "parameters": {
        "jsCode": "// Zbieramy wyniki wszystkich trzech healthchecków.\n// n8n wykonuje węzły sekwencyjnie — odczytujemy z poprzednich węzłów.\nconst appHealth = $('Check App Health').first()?.json || {};\nconst newApiHealth = $('Check new-api :3000').first()?.json || {};\nconst qdrantRaw = $('Check Qdrant :6333').first()?.json || {};\n\nconst appOk = appHealth.success === true && appHealth.overall !== 'error';\nconst qdrantOk = appHealth.qdrant_status === 'ok';\nconst llmOk = appHealth.llm_status === 'ok';\nconst newApiOk = !newApiHealth.error;\n\nconst alerts = [];\nif (!appOk) alerts.push('APP DOWN lub błąd: ' + (appHealth.error || appHealth.overall));\nif (!qdrantOk) alerts.push('Qdrant niedostępny');\nif (!llmOk) alerts.push('LLM degraded: ' + (appHealth.llm?.detail || '?'));\nif (!newApiOk) alerts.push('new-api :3000 błąd: ' + (newApiHealth.error?.message || '?'));\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    overall_ok: alerts.length === 0,\n    alerts,\n    details: {\n      app: {\n        ok: appOk,\n        overall: appHealth.overall,\n        version: appHealth.version,\n        provider: appHealth.provider,\n        llm_model: appHealth.llm_model,\n        vectors: appHealth.vectors_count\n      },\n      qdrant: { ok: qdrantOk },\n      llm: { ok: llmOk, detail: appHealth.llm?.detail },\n      new_api_3000: { ok: newApiOk }\n    }\n  }\n}];"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.overall_ok }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Any Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 380]
    },
    {
      "parameters": {
        "jsCode": "// ALERT — wyślij powiadomienie (podłącz do Slack/email/webhook).\n// Zastąp ten węzeł rzeczywistym kanałem alertów.\nconst data = $input.first().json;\nconsole.log('ALERT:', JSON.stringify(data.alerts));\nreturn [{ json: { action: 'alert_sent', alerts: data.alerts, ts: data.timestamp } }];"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000007",
      "name": "Send Alert (placeholder)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 280]
    },
    {
      "parameters": {
        "jsCode": "// Wszystko OK — opcjonalnie loguj.\nconst data = $input.first().json;\nconsole.log('Health OK:', data.details?.app?.version, data.timestamp);\nreturn [{ json: { action: 'ok', ts: data.timestamp } }];"
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000008",
      "name": "Log OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 480]
    }
  ],
